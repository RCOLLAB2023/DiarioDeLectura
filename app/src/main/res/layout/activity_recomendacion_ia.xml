<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloIA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_ia"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtPromptIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="top|start"
            android:hint="@string/hint_prompt_ia"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <Button
            android:id="@+id/btnRecomendarIA"
            style="@style/Widget.DiarioDeLectura.BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_recomendar_ia" />

        <TextView
            android:id="@+id/txtRespuestaIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/fondo_tarjeta"
            android:padding="16dp"
            android:text="@string/respuesta_ia_ejemplo"
            android:textColor="@color/texto_principal"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>