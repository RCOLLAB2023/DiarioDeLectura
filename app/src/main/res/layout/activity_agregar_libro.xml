<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloAgregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_agregar"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtTituloLibro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/hint_titulo_libro"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <EditText
            android:id="@+id/edtAutor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_autor"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:minHeight="48dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <TextView
            android:id="@+id/txtEtiquetaGenero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/etiqueta_genero"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spGenero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/generos"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/txtEtiquetaNota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/etiqueta_nota"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spCalificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/calificaciones"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtResena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="top|start"
            android:hint="@string/hint_resena"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swFavorito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/sw_favorito"
            android:textColor="@color/texto_principal" />

        <Button
            android:id="@+id/btnGuardarLibro"
            style="@style/Widget.DiarioDeLectura.BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_guardar_libro" />

    </LinearLayout>
</ScrollView>